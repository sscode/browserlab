# Copy to .env and enter your own keys locally. Never commit .env.
# Use: browserlab doctor --targets browserbase,browserless --env-file .env
BROWSERBASE_API_KEY=
# Optional: otherwise Browserbase infers the project from the key.
BROWSERBASE_PROJECT_ID=
BROWSERLESS_API_KEY=

# Optional additional providers. Only selected targets need credentials.
STEEL_API_KEY=
BROWSER_USE_API_KEY=
# Bright Data Browser API zone credentials (not a general API key).
BRIGHT_DATA_BROWSER_USERNAME=
BRIGHT_DATA_BROWSER_PASSWORD=
HYPERBROWSER_API_KEY=
ANCHOR_API_KEY=
